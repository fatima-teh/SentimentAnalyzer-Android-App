<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F3FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="🧠 AI Sentiment Analyzer"
            android:textColor="#25245C"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="26dp"
            android:gravity="center"
            android:text="Your words, understood by AI ✨"
            android:textColor="#7775A8"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card_white">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="💬 Enter Your Text"
                android:textColor="#34316C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputText"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/input_background"
                android:gravity="top|start"
                android:hint="Write a review or comment here..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:padding="14dp"
                android:textColor="#292750"
                android:textColorHint="#9998B5"
                android:textSize="16sp" />

            <Button
                android:id="@+id/analyzeButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#7775E8"
                android:clickable="true"
                android:enabled="true"
                android:focusable="true"
                android:text="Analyze Sentiment"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/result_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Prediction Result"
                android:textColor="#34316C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="💭"
                android:textSize="46sp" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Your result will appear here"
                android:textColor="#168F78"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Enter some text above to get started."
                android:textColor="#64648A"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="♡ Powered by TensorFlow Lite"
            android:textColor="#7775A8"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
